# Bu dosyayı .env adıyla kopyala ve doldur:  cp .env.example .env

# Alan adı yoksa sunucu IP'sinden: 1.2.3.4 -> 1-2-3-4.sslip.io
DOMAIN=1-2-3-4.sslip.io

# İlk açılışta oluşturulacak hesaplar (sonra şifre değiştirmek için README'ye bak)
YKS_OGRENCI_KULLANICI=ogrenci
YKS_OGRENCI_SIFRE=buraya-guclu-bir-sifre
YKS_OGRENCI_AD=Öğrenci

YKS_TAKIPCI_KULLANICI=takipci
YKS_TAKIPCI_SIFRE=buraya-baska-guclu-bir-sifre
YKS_TAKIPCI_AD=Takipçi

# Kaç günlük yedek saklansın
YKS_BACKUP_KEEP=30
