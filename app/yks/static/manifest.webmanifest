{
  "name": "YKS Takip",
  "short_name": "YKS Takip",
  "description": "Yanlışları kapatma ve günlük görev takibi",
  "lang": "tr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f3f0",
  "theme_color": "#1c5cab",
  "icons": [
    { "src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Hata ekle", "url": "/#/hata-ekle", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Deneme gir", "url": "/#/deneme-ekle", "icons": [{ "src": "/static/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/paylas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "baslik", "text": "metin", "files": [{ "name": "gorsel", "accept": ["image/*"] }] }
  }
}
